#
# Failsafe Web UI
#

config WEBUI_FAILSAFE
	bool "Enable Failsafe Web UI"
	select MTK_TCP
	select MTK_HTTPD
	select MTK_DHCPD
	default n
	help
	  Enable Web based failsafe UI.
	  This also starts a minimal DHCP server so that a directly
	  connected PC can obtain an IP automatically.

config WEBUI_FAILSAFE_INITRAMFS
	bool "Enable initramfs boot via Web failsafe"
	depends on WEBUI_FAILSAFE
	default n
	help
	  Allow uploading an initramfs kernel image via the web failsafe
	  UI and booting it directly from RAM without writing to flash.
	  This is useful for recovery, testing, or one-time boot of a
	  custom kernel.

config WEBUI_FAILSAFE_VENDOR
	string "Vendor name for failsafe web UI banner"
	depends on WEBUI_FAILSAFE
	default "MediaTek"
	help
	  Set the vendor name displayed in the failsafe web UI title
	  and banner.  For QCA/Atheros platforms, set this to
	  "Qualcomm Atheros".
