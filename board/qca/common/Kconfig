# QCA platform common configuration
#

menuconfig QCA_BOOTMENU
	bool "Enable QCA bootmenu framework"
	depends on ARCH_ATH79
	select CMD_BOOTMENU
	select CMD_MTD
	default n
	help
	  Enable QCA bootmenu containing features for easy
	  firmware/bootloader upgrading and booting via a
	  countdown menu at startup.

if QCA_BOOTMENU

config QCA_BOOTMENU_COUNTDOWN
	bool "Enable bootmenu countdown"
	default y
	help
	  Enable bootmenu auto-booting countdown timer.

config QCA_BOOTMENU_DELAY
	int "QCA bootmenu delay time (s)"
	range 1 10
	default 4
	depends on QCA_BOOTMENU_COUNTDOWN
	help
	  The delay seconds for the bootmenu to show before running
	  the default command.

config QCA_BOOTMENU_LEGACY
	bool "Use legacy rootfs+uImage partition layout"
	depends on QCA_BOOTMENU
	default n
	help
	  Use the legacy rootfs+uImage MTD partition scheme instead
	  of the unified firmware partition.

	  Enable this for AP143 and similar devices that have separate
	  rootfs and uImage MTD partitions rather than a single
	  firmware partition.

	  Legacy layout example:
	    u-boot | u-boot-env | rootfs | uImage | ART

	  New layout example:
	    u-boot | u-boot-env | firmware | ART

endif # QCA_BOOTMENU

config QCA_WEB_FAILSAFE
	bool "Enable Web-based failsafe for firmware upgrading"
	default n
	select WEBUI_FAILSAFE
	help
	  Enable Web-based failsafe for firmware upgrading.  A bootmenu
	  item will be added to allow entering failsafe mode.

config QCA_WEB_FAILSAFE_AFTER_BOOT_FAILURE
	bool "Automatically start failsafe after booting failure"
	depends on QCA_WEB_FAILSAFE
	default y
	help
	  If the default OS boot fails, the Web failsafe UI will be
	  started automatically so that a working firmware image can
	  be uploaded without re-entering the bootmenu.

	  When disabled, a boot failure simply returns to the
	  U-Boot console prompt.

config QCA_FAILSAFE_NAND
	bool "Enable NAND flash support for QCA failsafe"
	depends on QCA_WEB_FAILSAFE && MTD && ARCH_ATH79
	default n
	help
	  Enable NAND flash write path for the web failsafe UI.
	  When enabled, the failsafe write functions will perform
	  bad-block-aware erase/write suitable for NAND flash.
	  When disabled (default), only NOR flash is supported.

	  This option is kept for future NAND board support.
	  Current QCA boards (AP143/AP135/AP152) use NOR flash only.

if ARCH_ATH79 && WEBUI_FAILSAFE

config WEBUI_FAILSAFE_VENDOR
	default "Qualcomm Atheros"

endif
