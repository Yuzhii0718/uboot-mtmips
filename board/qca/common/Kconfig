# QCA platform common configuration
#

menuconfig QCA_BOOTMENU
	bool "Enable QCA bootmenu framework"
	depends on ARCH_ATH79
	select CMD_BOOTMENU
	select CMD_MTD
	default n
	help
	  Enable QCA bootmenu containing features for easy
	  firmware/bootloader upgrading and booting via a
	  countdown menu at startup.

if QCA_BOOTMENU

config QCA_BOOTMENU_COUNTDOWN
	bool "Enable bootmenu countdown"
	default y
	help
	  Enable bootmenu auto-booting countdown timer.

config QCA_BOOTMENU_DELAY
	int "QCA bootmenu delay time (s)"
	range 1 10
	default 4
	depends on QCA_BOOTMENU_COUNTDOWN
	help
	  The delay seconds for the bootmenu to show before running
	  the default command.

endif # QCA_BOOTMENU

config QCA_FAILSAFE_NAND
	bool "Enable NAND flash support for QCA failsafe"
	depends on WEBUI_FAILSAFE && MTD && ARCH_ATH79
	default n
	help
	  Enable NAND flash write path for the web failsafe UI.
	  When enabled, the failsafe write functions will perform
	  bad-block-aware erase/write suitable for NAND flash.
	  When disabled (default), only NOR flash is supported.

	  This option is kept for future NAND board support.
	  Current QCA boards (AP143/AP135/AP152) use NOR flash only.

if ARCH_ATH79 && WEBUI_FAILSAFE

config WEBUI_FAILSAFE_VENDOR
	default "Qualcomm Atheros"

endif
