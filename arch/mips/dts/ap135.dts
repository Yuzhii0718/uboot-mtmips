 *
 * AP135 Reference Board
 * QCA9558 SoC with 2 GMACs (GE0: SGMII/S17 switch, GE1: RGMII)
 */

/dts-v1/;
#include "qca955x.dtsi"

/ {
	model = "AP135 Reference Board";
	compatible = "qca,ap135", "qca,qca955x";

	aliases {
		spi0 = &spi0;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&xtal {
	clock-frequency = <25000000>;
};

&uart0 {
	clock-frequency = <25000000>;
	status = "okay";
};

&spi0 {
	spi-max-frequency = <25000000>;
	status = "okay";
	spi-flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "spi-flash";
		memory-map = <0x9f000000 0x01000000>;
		spi-max-frequency = <25000000>;
		reg = <0>;
	};
};

&gmac0 {
	phy-mode = "sgmii";
	status = "okay";
};

&gmac1 {
	phy-mode = "rgmii";
	status = "okay";
};
